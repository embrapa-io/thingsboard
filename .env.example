COMPOSE_PROJECT_NAME=thingsboard
COMPOSE_PROFILES=development
# Kafka, UI (HTTP), MQTT e pgAdmin são publicados SOMENTE em 127.0.0.1.
# Quem expõe à internet é o nginx do host: 443 -> PORT_WEB, e 1883/8883 -> PORT_MQTT
# com PROXY protocol (ver README e nginx/mqtt-stream.conf).
PORT_KAFKA=9092
PORT_WEB=9090
# Não usar 1883 aqui: a 1883 pública é do nginx.
PORT_MQTT=1884
PORT_EDGE_RPC=7070
PORT_PGADMIN=9091
DB_USER=thingsboard
DB_PASSWORD=secret
PGADMIN_USER=io@embrapa.br
PGADMIN_PASSWORD=secret
VOLUME_KAFKA=thingsboard_kafka
VOLUME_DB=thingsboard_db
VOLUME_THINGSBOARD=thingsboard_data
VOLUME_LOG=thingsboard_log
VOLUME_BACKUP=thingsboard_backup
VOLUME_PGADMIN=thingsboard_pgadmin
