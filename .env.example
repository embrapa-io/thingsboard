COMPOSE_PROJECT_NAME=thingsboard
COMPOSE_PROFILES=development
PORT_KAFKA=9092
PORT_WEB=9090
# Public web entry point. ThingsBoard itself is kept internal; Nginx publishes this port.
PORT_MQTT=1883
PORT_MQTTS=8883
PORT_EDGE_RPC=7070
PORT_PGADMIN=9091
# O transporte precisa ficar habilitado para manter MQTTS. MQTT simples
# permanece inacessível externamente enquanto o bind estiver em loopback.
MQTT_ENABLED=true
MQTT_BIND_ADDRESS=127.0.0.1
# The gateway credential is a dedicated, revocable ThingsBoard service credential.
# Leave empty until the auth-gateway user/token has been created.
TB_AUTH_GATEWAY_URL=http://thingsboard:8080
TB_AUTH_GATEWAY_TOKEN=
TB_AUTH_GATEWAY_TIMEOUT_MS=3000
TB_AUTH_GATEWAY_MAX_BODY_BYTES=32768
# Camada de telemetria (/telemetry/). O segredo assina os JWTs de projeto
# (autômato do Embrapa I/O) e de dispositivo (aba Consumo) e deve ser o mesmo
# TELEMETRY_JWT_SECRET do backend. TB_TELEMETRY_TOKEN é uma API key de um
# usuário de serviço do ThingsBoard, exclusiva desta camada.
TELEMETRY_JWT_SECRET=
TB_TELEMETRY_TOKEN=
TELEMETRY_MAX_RANGE_DAYS=31
TELEMETRY_MAX_POINTS=500
# Grafana IoT. GRAFANA_ADMIN_PASSWORD deve ser igual a GRAFANA_IOT_ADMIN_PASSWORD
# do backend. O whitelist é a sub-rede de GRAFANA_PROXY_NETWORK.
GRAFANA_VERSION=12.4.11
GRAFANA_INFINITY_VERSION=4.1.1
GRAFANA_ROOT_URL=http://localhost:8080/grafana/
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=secret
GRAFANA_AUTH_PROXY_WHITELIST=172.30.67.0/24
GRAFANA_PROXY_NETWORK=io_grafana
DB_USER=thingsboard
DB_PASSWORD=secret
PGADMIN_USER=io@embrapa.br
PGADMIN_PASSWORD=secret
VOLUME_KAFKA=thingsboard_kafka
VOLUME_DB=thingsboard_db
VOLUME_THINGSBOARD=thingsboard_data
VOLUME_LOG=thingsboard_log
VOLUME_BACKUP=thingsboard_backup
VOLUME_PGADMIN=thingsboard_pgadmin
VOLUME_GRAFANA=thingsboard_grafana
