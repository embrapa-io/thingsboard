# Contas do ambiente testado. Copie para .env e preencha; o .env nunca vai para o Git.
TB44_SYSADMIN_EMAIL=
TB44_SYSADMIN_PASSWORD=
TB44_TENANT_EMAIL=
TB44_TENANT_PASSWORD=
# Senhas fixas de ana e bruno (04-rbac.mjs); vazias, são geradas a cada rodada.
TB44_ANA_PASSWORD=
TB44_BRUNO_PASSWORD=

# Endereços e contêineres. Os valores abaixo são os padrões (ambiente isolado de 2026-10-21).
# TB44_BASE_URL=http://127.0.0.1:9290
# TB44_MQTT_URL=mqtt://127.0.0.1:18883
# TB44_EDGE_URL=http://127.0.0.1:9293
# TB44_EDGE_MQTT_URL=mqtt://127.0.0.1:19893
# TB44_SERVER_CONTAINER=embrapa-tb44-test-thingsboard-1
# TB44_EDGE_CONTAINER=embrapa-tb44-test-edge1-1
# Quantidade de Edges criados por 02-tenant-edges.mjs (o plano Free permite 1).
# TB44_EDGE_COUNT=1

# Chaves dos Edges: 02-tenant-edges.mjs acrescenta TB44_EDGE<n>_KEY e TB44_EDGE<n>_SECRET aqui.
